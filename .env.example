# Required: replace with a token from @BotFather.
BOT_TOKEN=
BOT_NAME=Gift Offer
# Change the administrator activation command before first use.
ADMIN_PROMO=/ReplaceThisAdminCode
DEFAULT_LANGUAGE=ru
OFFER_TTL_SECONDS=21600
CREATE_COOLDOWN_SECONDS=3
# Local launch only; Docker Compose sets /app/data/offers.sqlite3.
DB_PATH=data/offers.sqlite3
# Used only when DB_PATH is empty.
DATA_DIR=data
# Local HTTP port; 0 disables HTTP. Docker Compose sets 3000.
PORT=3000
# Host-side health port for Docker Compose (loopback only).
HEALTH_PORT=3000
# Optional event group and topic IDs. Zero disables notifications.
EVENT_CHAT_ID=0
NFT_TRANSFER_THREAD_ID=0
NEW_OFFER_THREAD_ID=0
